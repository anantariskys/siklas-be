    "paths": {
        "/admin/dosen": {
            "get": {
                "tags": [
                    "Admin - Dosens"
                ],
                "summary": "List and search lecturers",
                "operationId": "listDosens",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search by name",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Items per page",
                        "schema": {
                            "type": "integer",
                            "default": 10
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "List dosen berhasil diambil"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        },
                                        "meta": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Admin - Dosens"
                ],
                "summary": "Create a new lecturer",
                "operationId": "storeDosen",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StoreDosenRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Dosen berhasil ditambahkan"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/admin/dosen/{id}": {
            "put": {
                "tags": [
                    "Admin - Dosens"
                ],
                "summary": "Update an existing lecturer",
                "operationId": "updateDosen",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateDosenRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Dosen berhasil diperbarui"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Admin - Dosens"
                ],
                "summary": "Delete a lecturer",
                "operationId": "deleteDosen",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Dosen berhasil dihapus"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/admin/user": {
            "get": {
                "tags": [
                    "Admin - Users"
                ],
                "summary": "List and search users",
                "description": "Retrieve a paginated list of users with search and role filters",
                "operationId": "listUsers",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Search by name or email",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "role",
                        "in": "query",
                        "description": "Filter by role",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "mahasiswa",
                                "kaprodi",
                                "dosen"
                            ]
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "Items per page",
                        "schema": {
                            "type": "integer",
                            "default": 10
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Users retrieved successfully"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        },
                                        "meta": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Admin - Users"
                ],
                "summary": "Create a new user",
                "operationId": "storeUser",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StoreUserRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User created successfully"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/admin/user/{id}": {
            "put": {
                "tags": [
                    "Admin - Users"
                ],
                "summary": "Update an existing user",
                "operationId": "updateUser",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateUserRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "User updated successfully"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Admin - Users"
                ],
                "summary": "Delete a user",
                "operationId": "deleteUser",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User deleted successfully"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "User Authentication",
                "description": "Authenticate user and return token",
                "operationId": "authenticate",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "username",
                                    "password"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "example": "admin"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Login berhasil"
                                        },
                                        "data": {
                                            "properties": {
                                                "user": {
                                                    "type": "object"
                                                },
                                                "token": {
                                                    "type": "string"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    },
                    "422": {
                        "description": "Validation Error"
                    }
                },
                "security": []
            }
        },
        "/bidang-penelitian/options": {
            "get": {
                "tags": [
                    "Public - Bidang Penelitian"
                ],
                "summary": "Get all fields of study as options",
                "operationId": "getBidangPenelitianOptions",
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Bidang penelitian berhasil diambil"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/dashboard": {
            "get": {
                "tags": [
                    "Dashboard"
                ],
                "summary": "Get dashboard statistics",
                "description": "Get dashboard statistics based on the authenticated user role. Admin sees global stats, Kaprodi sees program-specific stats, and others see their own stats.",
                "operationId": "getDashboardStats",
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Data dashboard berhasil diambil"
                                        },
                                        "data": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/dosen/{bidangPenelitian}": {
            "get": {
                "tags": [
                    "Public - Dosens"
                ],
                "summary": "Get lecturers by research field slug",
                "operationId": "getDosenByBidang",
                "parameters": [
                    {
                        "name": "bidangPenelitian",
                        "in": "path",
                        "description": "Slug of the research field",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Dosen retrieved successfully"
                                        },
                                        "data": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Bidang penelitian tidak ditemukan"
                    }
                },
                "security": []
            }
        },
        "/riwayat-klasifikasi": {
            "get": {
                "tags": [
                    "Riwayat Klasifikasi"
                ],
                "summary": "List classification history",
                "description": "Get classification history based on the authenticated user role. Admin sees all, Kaprodi sees program-specific history, and others see their own.",
                "operationId": "listRiwayatKlasifikasi",
                "parameters": [
                    {
                        "name": "search",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 10
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "success"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Daftar riwayat klasifikasi berhasil diambil"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Riwayat Klasifikasi"
                ],
                "summary": "Create a new classification record",
                "operationId": "storeRiwayatKlasifikasi",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "prediksi_topik"
                                ],
                                "properties": {
                                    "user_id": {
                                        "type": "integer",
                                        "nullable": true
                                    },
                                    "judul": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "abstrak": {
                                        "type": "string",
                                        "nullable": true
                                    },
                                    "prediksi_topik": {
                                        "type": "string"
                                    },
                                    "confidence_score": {
                                        "type": "number",
                                        "format": "float",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Riwayat klasifikasi berhasil disimpan"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/riwayat-klasifikasi/{id}": {
            "get": {
                "tags": [
                    "Riwayat Klasifikasi"
                ],
                "summary": "Get a single classification record",
                "operationId": "getRiwayatKlasifikasi",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    },
                    "404": {
                        "description": "Riwayat klasifikasi tidak ditemukan"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Riwayat Klasifikasi"
                ],
                "summary": "Delete a classification record",
                "operationId": "deleteRiwayatKlasifikasi",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    },
                    "404": {
                        "description": "Riwayat klasifikasi tidak ditemukan"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "StoreDosenRequest": {
                "required": [
                    "nama",
                    "bidang_penelitian_major_id"
                ],
                "properties": {
                    "nama": {
                        "type": "string",
                        "example": "Dr. John Doe"
                    },
                    "gelar_awal": {
                        "type": "string",
                        "example": "Dr."
                    },
                    "gelar_akhir": {
                        "type": "string",
                        "example": "M.Kom."
                    },
                    "bidang_penelitian_major_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "minors_id": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        },
                        "example": [
                            2,
                            3
                        ]
                    }
                },
                "type": "object"
            },
            "UpdateDosenRequest": {
                "properties": {
                    "nama": {
                        "type": "string",
                        "example": "Dr. John Doe Updated"
                    },
                    "gelar_awal": {
                        "type": "string",
                        "nullable": true
                    },
                    "gelar_akhir": {
                        "type": "string",
                        "nullable": true
                    },
                    "bidang_penelitian_major_id": {
                        "type": "integer"
                    },
                    "minors_id": {
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    }
                },
                "type": "object"
            },
            "StoreUserRequest": {
                "required": [
                    "name",
                    "username",
                    "email",
                    "password",
                    "role"
                ],
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "John Doe"
                    },
                    "username": {
                        "type": "string",
                        "example": "johndoe"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "johndoe@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password"
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "mahasiswa",
                            "admin",
                            "kaprodi",
                            "dosen"
                        ],
                        "example": "mahasiswa"
                    },
                    "program_studi": {
                        "type": "string",
                        "enum": [
                            "PTI",
                            "SI",
                            "TI",
                            "TIF",
                            "TEKKOM",
                            "NULL"
                        ],
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "UpdateUserRequest": {
                "properties": {
                    "name": {
                        "type": "string",
                        "example": "John Doe Updated"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "johndoe.updated@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "nullable": true
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "mahasiswa",
                            "admin",
                            "kaprodi",
                            "dosen"
                        ]
                    },
                    "program_studi": {
                        "type": "string",
                        "enum": [
                            "PTI",
                            "SI",
                            "TI",
                            "TIF",
                            "TEKKOM",
                            "NULL"
                        ],
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "LoginRequest": {
                "required": [
                    "username",
                    "password"
                ],
                "properties": {
                    "username": {
                        "type": "string",
                        "example": "admin"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Enter your Sanctum token",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
